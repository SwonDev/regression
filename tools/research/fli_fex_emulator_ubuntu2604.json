{
  "emulator_v0": {
    "argv": "./usr/bin/FEX",
    "environment": {
      "FEX_PORTABLE": "1"
    },
    "container_argv": "./usr/bin/FEX",
    "container_environment": {
      "FEX_ROOTFS": null,
      "STEAM_COMPAT_GRAPHICS_PROVIDER": "/run/gfx/main/graphics-provider.json",
      "VK_DRIVER_FILES": "/usr/share/vulkan/icd.d/virtio_icd.json",
      "VK_IMPLICIT_LAYER_PATH": ""
    },
    "main_argv": "./FEXCompatTool",
    "server_argv": "./usr/bin/FEXServerManager",
    "emulated_architectures": [
      "x86_64-linux-gnu",
      "i386-linux-gnu"
    ],
    "required_architectures": [
      "aarch64-linux-gnu"
    ],
    "required_libraries": [
      "libc.so.6",
      "libstdc++.so.6"
    ]
  }
}
