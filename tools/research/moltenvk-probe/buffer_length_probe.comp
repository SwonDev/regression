#version 450

// El tamaño de un array dinámico no lo puede preguntar el shader a Metal: MoltenVK lo publica en
// un buffer implícito que sólo rellena cuando hay bindings de buffer marcadas como sucias. Con
// argument buffers puede no haberlas, y entonces ese buffer se enlaza vacío —Metal lo redondea a
// 1 byte— y la lectura del tamaño se sale. Este patrón fuerza esa secuencia: varios dispatches con
// una re-vinculación de pipeline en medio, sin volver a enlazar los descriptor sets.
layout(local_size_x = 1) in;

layout(set = 0, binding = 0) buffer Salida  { uint valores[]; } salida;
layout(set = 1, binding = 0) readonly buffer Origen { uint datos[]; } origen;

layout(push_constant) uniform Empuje { uint ranura; } empuje;

void main() {
    uint n = origen.datos.length();
    salida.valores[empuje.ranura] = n;
}
