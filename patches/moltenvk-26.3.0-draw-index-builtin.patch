+		_shaderStageResourceBindings[i].drawIndexBufferBinding.index = binding.stages[i];
+		_shaderStageResourceBindings[i].drawIndexBufferBinding.isDirty = false;
+	}
+	_needsDrawIndexBuffer = needDrawIndexBuffer;
+	_drawIndex = 0;
+	_shaderStageResourceBindings[kMVKShaderStageVertex].drawIndexBufferBinding.isDirty = needDrawIndexBuffer;
+}
