+static int regression_unix_target_is_safe( const char *target, const char *resolved_prefix )
+{
+    static const char shared_root[] =
+        "/drive_c/Program Files (x86)/Steam/steamapps/common/";
+    struct stat st;
+    size_t prefix_length = strlen( resolved_prefix );
+    const char *component, *relative;
+
+    if (!target || !target[0] || strlen( target ) >= PATH_MAX ||
+        strncmp( target, resolved_prefix, prefix_length )) return 0;
+    relative = target + prefix_length;
+    if (strncmp( relative, shared_root, sizeof(shared_root) - 1 )) return 0;
+    component = relative + sizeof(shared_root) - 1;
+    while (*component)
+    {
+        const char *end = strchr( component, '/' );
+        size_t length = end ? (size_t)(end - component) : strlen( component );
+        if (!length || (length == 1 && component[0] == '.') ||
+            (length == 2 && component[0] == '.' && component[1] == '.')) return 0;
+        if (!end) break;
+        component = end + 1;
+    }
+    return !lstat( target, &st ) && S_ISREG( st.st_mode ) && !S_ISLNK( st.st_mode );
 }
 
 
+static WCHAR *regression_environment_shipping_image( const WCHAR *image, UINT image_len,
+                                                      UINT *redirected_len )
+{
+    static const char drive_root[] = "/drive_c/";
+    const char *prefix = getenv( "WINEPREFIX" );
+    char resolved_prefix[PATH_MAX], source_variable[80], target_variable[80];
+    unsigned int i, count;
+
+    if (!prefix || !prefix[0] || !realpath( prefix, resolved_prefix )) return NULL;
+    count = regression_bootstrap_route_count();
+    for (i = 0; i < count; i++)
+    {
+        const char *source, *target, *relative;
+        WCHAR converted[PATH_MAX], *result;
+        DWORD converted_chars;
+        size_t target_chars, j;
+
+        snprintf( source_variable, sizeof(source_variable),
+                  "REGRESSION_BOOTSTRAP_REDIRECT_%u_EXECUTABLE", i );
+        snprintf( target_variable, sizeof(target_variable),
+                  "REGRESSION_BOOTSTRAP_REDIRECT_%u_TARGET", i );
+        source = getenv( source_variable );
+        target = getenv( target_variable );
+        if (!regression_bootstrap_source_matches( image, image_len, source ) ||
+            !regression_unix_target_is_safe( target, resolved_prefix )) continue;
+
+        relative = target + strlen( resolved_prefix ) + sizeof(drive_root) - 1;
+        /* Startup image paths from wineserver use the NT \??\ prefix.  Keep
+         * that contract so copy_dos_path_string() strips exactly the prefix
+         * instead of truncating the drive-qualified DOS path. */
+        converted[0] = '\\';
+        converted[1] = '?';
+        converted[2] = '?';
+        converted[3] = '\\';
+        converted[4] = 'C';
+        converted[5] = ':';
+        converted[6] = '\\';
+        converted_chars = ntdll_umbstowcs( relative, strlen( relative ),
+                                           converted + 7, ARRAY_SIZE(converted) - 8 );
+        if (!converted_chars || converted_chars >= ARRAY_SIZE(converted) - 8) continue;
+        target_chars = converted_chars + 7;
+        for (j = 7; j < target_chars; j++)
+            if (converted[j] == '/') converted[j] = '\\';
+        converted[target_chars] = 0;
+        if (target_chars > (USHRT_MAX / sizeof(WCHAR)) - 1 ||
+            !(result = malloc( (target_chars + 1) * sizeof(WCHAR) ))) return NULL;
+        memcpy( result, converted, (target_chars + 1) * sizeof(WCHAR) );
+        *redirected_len = target_chars * sizeof(WCHAR);
+        return result;
+    }
+    return NULL;
+}
+
+
+static WCHAR *regression_shipping_image( const WCHAR *image, UINT image_len,
+                                         UINT *redirected_len )
+{
+    WCHAR *target = regression_environment_shipping_image( image, image_len, redirected_len );
+    if (target) return target;
+    return regression_tq2_shipping_image( image, image_len, redirected_len );
+}
