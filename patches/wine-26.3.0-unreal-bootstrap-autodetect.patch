+static int regression_bootstrap_source_matches( const WCHAR *image, UINT image_len,
+                                                const char *source )
+{
+    static const char steam_common[] = "\\steamapps\\common\\";
+    size_t image_chars, source_chars, start, i, marker_chars = sizeof(steam_common) - 1;
+    int has_steam_common = 0;
+
+    if (!source || !source[0] || strlen( source ) >= 128 ||
+        strchr( source, '/' ) || strchr( source, '\\' ) || strchr( source, ':' ) ||
+        image_len % sizeof(WCHAR)) return 0;
+    image_chars = image_len / sizeof(WCHAR);
+    source_chars = strlen( source );
+    if (image_chars < source_chars) return 0;
+    start = image_chars - source_chars;
+    for (i = 0; i < source_chars; i++)
+        if (ntdll_towupper( image[start + i] ) !=
+            ntdll_towupper( (unsigned char)source[i] )) return 0;
+    if (start && image[start - 1] != '\\' && image[start - 1] != '/') return 0;
+
+    for (i = 0; i + marker_chars <= image_chars; i++)
+    {
+        size_t j;
+        for (j = 0; j < marker_chars; j++)
+            if (ntdll_towupper( image[i + j] ) !=
+                ntdll_towupper( (unsigned char)steam_common[j] )) break;
+        if (j == marker_chars)
+        {
+            has_steam_common = 1;
+            break;
+        }
+    }
+    return has_steam_common;
+}
