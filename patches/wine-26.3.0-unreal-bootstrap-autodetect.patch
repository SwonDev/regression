+static unsigned int regression_bootstrap_route_count(void)
+{
+    const char *value = getenv( "REGRESSION_BOOTSTRAP_REDIRECT_COUNT" );
+    char *end;
+    unsigned long count;
+
+    if (!value || !value[0]) return 0;
+    count = strtoul( value, &end, 10 );
+    if (*end || !count || count > 16) return 0;
+    return count;
+}
