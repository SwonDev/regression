+static int regression_path_has_no_dot_components( const char *path )
+{
+    const char *component = path;
+
+    while (*component)
+    {
+        const char *end = strchr( component, '/' );
+        size_t length = end ? (size_t)(end - component) : strlen( component );
+
+        if (!length || (length == 1 && component[0] == '.') ||
+            (length == 2 && component[0] == '.' && component[1] == '.')) return 0;
+        if (!end) break;
+        component = end + 1;
+    }
+    return 1;
 }
 
+static int regression_bootstrap_target_is_safe( const char *target,
+                                                const char *resolved_prefix,
+                                                char resolved_target[PATH_MAX],
+                                                const char **selected_target )
+{
+    static const char drive_root[] = "/drive_c/";
+    static const char shared_root[] =
+        "/drive_c/Program Files (x86)/Steam/steamapps/common/";
+    struct stat st;
+    size_t prefix_length = strlen( resolved_prefix );
+    const char *relative;
+
+    if (!target || !target[0] || strlen( target ) >= PATH_MAX ||
+        strncmp( target, resolved_prefix, prefix_length )) return 0;
+    relative = target + prefix_length;
+    if (!strncmp( relative, drive_root, sizeof(drive_root) - 1 ) &&
+        realpath( target, resolved_target ) &&
+        !strncmp( resolved_target, resolved_prefix, prefix_length ) &&
+        !strncmp( resolved_target + prefix_length, drive_root, sizeof(drive_root) - 1 ))
+    {
+        *selected_target = resolved_target;
+        return 1;
+    }
+
+    /* Regression puede compartir únicamente steamapps mediante un enlace
+     * canónico. Conservamos la ruta lógica dentro del prefijo y validamos cada
+     * componente posterior; nunca se acepta otro escape por symlink. */
+    if (strncmp( relative, shared_root, sizeof(shared_root) - 1 ) ||
+        !regression_path_has_no_dot_components( relative + sizeof(shared_root) - 1 ) ||
+        lstat( target, &st ) || !S_ISREG( st.st_mode ) || S_ISLNK( st.st_mode )) return 0;
+    *selected_target = target;
+    return 1;
+}
