+static int regression_valid_activation_basename( const char *name )
+{
+    const unsigned char *cursor = (const unsigned char *)name;
+    size_t length;
+    int has_dot = 0;
+
+    if (!name || !(length = strlen( name )) || length >= 120) return 0;
+    for (; *cursor; cursor++)
+    {
+        if (*cursor == '.') has_dot = 1;
+        else if ((*cursor < 'a' || *cursor > 'z') &&
+                 (*cursor < 'A' || *cursor > 'Z') &&
+                 (*cursor < '0' || *cursor > '9') &&
+                 *cursor != '-' && *cursor != '_' && *cursor != ' ') return 0;
+    }
+    return has_dot;
 }
