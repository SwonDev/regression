+static int regression_known_compiled_repair( const char *recipe )
+{
+    return !strcmp( recipe, "unreal-d3d11-dual-overlay-isolation-v1" ) ||
+           !strcmp( recipe, "unity-intro-winegstreamer-isolation-v1" ) ||
+           !strcmp( recipe, "unity-macos-focus-borderless-v1" ) ||
+           !strcmp( recipe, "gamemaker-retina-fullscreen-v1" );
+}
