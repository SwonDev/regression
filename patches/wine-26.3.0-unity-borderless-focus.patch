+/* El prelanzador de REDengine abre una interfaz Qt WebEngine —Chromium embebido— que revienta
+ * bajo Wine y deja el arranque colgado en el depurador.  Su propio binario admite
+ * `--launcher-skip`, que es exactamente lo que hace un usuario que no quiere esa interfaz: se
+ * la salta y arranca el juego.  Se añade solo a ese proceso exacto y solo si no venía ya. */
+static int regression_force_prelauncher_skip( const WCHAR *image, UINT image_len,
+                                              const WCHAR *command_line,
+                                              UINT command_line_len )
+{
+    if (regression_command_line_contains_ascii( command_line, command_line_len,
+                                                "--launcher-skip" )) return 0;
+    return regression_bootstrap_source_matches( image, image_len, "redprelauncher.exe" );
+}
