+/* Read the closed activation format written by Regression.  Records can only
+ * select a recipe compiled above for one exact PE basename; they cannot add a
+ * command, argument, path or arbitrary action. */
+static int regression_activation_matches( const WCHAR *image, UINT image_len,
+                                          const char *wanted_recipe )
+{
+    static const char header[] = "REGRESSION-COMPILED-REPAIRS\t2\n";
+    const char *prefix = getenv( "WINEPREFIX" );
+    char path[PATH_MAX], line[320], *app_id, *executable, *recipe, *newline;
+    struct stat st;
+    FILE *file;
+    int fd, matched = 0, path_length;
+    unsigned int count = 0;
+
+    if (!prefix || !prefix[0] || !regression_known_compiled_repair( wanted_recipe ) ||
+        (path_length = snprintf( path, sizeof(path),
+                                 "%s/.regression/compiled-repair-activations-v2.tsv",
+                                 prefix )) < 0 ||
+        (size_t)path_length >= sizeof(path) || lstat( path, &st ) ||
+        !S_ISREG( st.st_mode ) || st.st_uid != geteuid() ||
+        (st.st_mode & 0022) || st.st_size <= 0 || st.st_size > 64 * 1024) return 0;
+    if ((fd = open( path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW )) == -1) return 0;
+    if (!(file = fdopen( fd, "r" )))
+    {
+        close( fd );
+        return 0;
+    }
+    if (!fgets( line, sizeof(line), file ) || strcmp( line, header )) goto invalid;
+
+    while (fgets( line, sizeof(line), file ))
+    {
+        if (++count > 128 || !(newline = strchr( line, '\n' )) || newline[1]) goto invalid;
+        *newline = 0;
+        /* v2 record: App ID, exact PE basename and one recipe compiled above. */
+        app_id = line;
+        if (!(executable = strchr( line, '\t' ))) goto invalid;
+        *executable++ = 0;
+        if (!(recipe = strchr( executable, '\t' )) || strchr( recipe + 1, '\t' )) goto invalid;
+        *recipe++ = 0;
+        if (!regression_valid_activation_basename( executable ) ||
+            !regression_known_compiled_repair( recipe )) goto invalid;
+        if (!strcmp( recipe, wanted_recipe ) &&
+            regression_bootstrap_source_matches( image, image_len, executable ) &&
+            regression_image_belongs_to_steam_app( image, image_len, app_id )) matched = 1;
+    }
+    if (ferror( file )) goto invalid;
+    fclose( file );
+    return matched;
+
+invalid:
+    fclose( file );
+    return 0;
 }
 
 
+static int regression_command_line_contains_ascii( const WCHAR *command_line,
+                                                   UINT command_line_len,
+                                                   const char *needle )
+{
+    size_t chars, needle_chars, i, j;
+
+    if (!command_line || command_line_len % sizeof(WCHAR)) return 0;
+    chars = command_line_len / sizeof(WCHAR);
+    needle_chars = strlen( needle );
+    if (!needle_chars || chars < needle_chars) return 0;
+    for (i = 0; i + needle_chars <= chars; i++)
+    {
+        for (j = 0; j < needle_chars; j++)
+            if (ntdll_towupper( command_line[i + j] ) !=
+                ntdll_towupper( (unsigned char)needle[j] )) break;
+        if (j == needle_chars) return 1;
+    }
+    return 0;
+}
