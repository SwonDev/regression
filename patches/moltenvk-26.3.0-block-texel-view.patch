+// VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT is emulated: Metal refuses an uncompressed
+// view of a compressed texture, and aliasing both onto one heap allocation does not work either
+// -- their internal layouts differ, measurably. So the view owns separate storage and the image
+// reconciles it at the barriers. Set REGRESSION_MVK_BLOCK_TEXEL_VIEW=0 to restore the plain
+// rejection, which is how the emulation is A/B tested.
+// Aislar la reconciliación de contenido sin recompilar: REGRESSION_MVK_BLOCK_TEXEL_SYNC=0 deja la
+// emulación en pie pero no copia nada, que es como se acota si un fallo viene de las copias.
+bool mvkRegressionBlockTexelSyncEnabled() {
+	static int enabled = -1;
+	if (enabled < 0) {
+		const char* v = getenv("REGRESSION_MVK_BLOCK_TEXEL_SYNC");
+		enabled = (v && v[0] == '0') ? 0 : 1;
+	}
+	return enabled == 1;
 }
 
