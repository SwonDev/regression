+void MVKImageViewPlane::syncBlockTexelContent(MVKCommandEncoder* cmdEncoder,
+											  MVKCommandUse cmdUse,
+											  bool viewToImage) {
+	id<MTLTexture> mtlView = getMTLTexture();
+	id<MTLTexture> mtlImage = _imageView->_image->getMTLTexture(_planeIndex);
+	if ( !mtlView || !mtlImage ) { return; }
+
+	NSUInteger blockBytes = getPixelFormats()->getBytesPerBlock(_mtlPixFmt);
+	NSUInteger bytesPerRow = mtlView.width * blockBytes;
+	NSUInteger bytesPerImage = bytesPerRow * mtlView.height;
+	NSUInteger sliceCount = (mtlView.textureType == MTLTextureType3D) ? 1 : mtlView.arrayLength;
+	NSUInteger depth = (mtlView.textureType == MTLTextureType3D) ? mtlView.depth : 1;
+
+	// Dedicated: a pooled allocation would start at an arbitrary offset inside a shared buffer, and
+	// a blit whose offset is not aligned to the block size does not fail -- it faults the GPU, and
+	// the game only sees VK_ERROR_DEVICE_LOST. A dedicated buffer always starts at offset zero.
+	const MVKMTLBufferAllocation* tempBuff = cmdEncoder->getTempMTLBuffer(bytesPerImage * depth * sliceCount, true, true);
+	id<MTLBlitCommandEncoder> mtlBlitEnc = cmdEncoder->getMTLBlitEncoder(cmdUse);
+
+	// The compressed image is addressed in texels and the view in blocks; both describe the same
+	// block grid, so the buffer round trip carries the content across unchanged.
+	MTLSize viewSize = MTLSizeMake(mtlView.width, mtlView.height, depth);
+	MTLSize imageSize = MTLSizeMake(mtlImage.width, mtlImage.height, depth);
+	MTLOrigin origin = MTLOriginMake(0, 0, 0);
+
+	for (NSUInteger slice = 0; slice < sliceCount; slice++) {
+		NSUInteger offset = tempBuff->_offset + (bytesPerImage * depth * slice);
+		if (viewToImage) {
+			[mtlBlitEnc copyFromTexture: mtlView
+							sourceSlice: slice
+							sourceLevel: 0
+						   sourceOrigin: origin
+							 sourceSize: viewSize
+							   toBuffer: tempBuff->_mtlBuffer
+					  destinationOffset: offset
+				 destinationBytesPerRow: bytesPerRow
+			   destinationBytesPerImage: bytesPerImage];
+			[mtlBlitEnc copyFromBuffer: tempBuff->_mtlBuffer
+						  sourceOffset: offset
+					 sourceBytesPerRow: bytesPerRow
+				   sourceBytesPerImage: bytesPerImage
+							sourceSize: imageSize
+							 toTexture: mtlImage
+					  destinationSlice: slice
+					  destinationLevel: 0
+					 destinationOrigin: origin];
+		} else {
+			[mtlBlitEnc copyFromTexture: mtlImage
+							sourceSlice: slice
+							sourceLevel: 0
+						   sourceOrigin: origin
+							 sourceSize: imageSize
+							   toBuffer: tempBuff->_mtlBuffer
+					  destinationOffset: offset
+				 destinationBytesPerRow: bytesPerRow
+			   destinationBytesPerImage: bytesPerImage];
+			[mtlBlitEnc copyFromBuffer: tempBuff->_mtlBuffer
+						  sourceOffset: offset
+					 sourceBytesPerRow: bytesPerRow
+				   sourceBytesPerImage: bytesPerImage
+							sourceSize: viewSize
+							 toTexture: mtlView
+					  destinationSlice: slice
+					  destinationLevel: 0
+					 destinationOrigin: origin];
+		}
+	}
 }
 
 
