+void MVKImage::addBlockTexelView(MVKImageViewPlane* viewPlane) {
+	for (auto* vp : _blockTexelViews) { if (vp == viewPlane) { return; } }
+	_blockTexelViews.push_back(viewPlane);
 }
 
+void MVKImage::removeBlockTexelView(MVKImageViewPlane* viewPlane) {
+	for (size_t i = 0; i < _blockTexelViews.size(); i++) {
+		if (_blockTexelViews[i] == viewPlane) {
+			_blockTexelViews[i] = _blockTexelViews[_blockTexelViews.size() - 1];
+			_blockTexelViews.pop_back();
+			return;
+		}
+	}
+}
