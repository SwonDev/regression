+// Metal cannot alias an uncompressed view onto a compressed texture, so each such view owns
+// separate storage. The two are reconciled here, at the barrier that publishes the writes:
+// shader writes travel from the view into the compressed image, and transfer writes travel back.
+void MVKImage::syncBlockTexelViews(MVKPipelineBarrier& barrier,
+								   MVKCommandEncoder* cmdEncoder,
+								   MVKCommandUse cmdUse) {
+	if (_blockTexelViews.empty() || !cmdEncoder) { return; }
+
+	if ( !mvkRegressionBlockTexelSyncEnabled() ) { return; }
+
+	bool viewToImage = mvkIsAnyFlagEnabled(barrier.srcAccessMask, VK_ACCESS_SHADER_WRITE_BIT);
+	bool imageToView = mvkIsAnyFlagEnabled(barrier.srcAccessMask, VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT);
+	if ( !viewToImage && !imageToView ) { return; }
+
+	for (auto* viewPlane : _blockTexelViews) {
+		viewPlane->syncBlockTexelContent(cmdEncoder, cmdUse, viewToImage);
+	}
+}
