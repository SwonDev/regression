@@ -2021,6 +2022,26 @@
 
     if (!context) return;
     if (flags & GL_FLUSH_INTERVAL) set_swap_interval(context, base->interval);
+
+    /* Regression: win32u hands GL_FLUSH_UPDATED to us only once per resize, and
+     * that token can be lost — a fullscreen transition is several SetWindowPos
+     * calls while the render thread keeps swapping, and the plain assignment
+     * "flags = GL_FLUSH_INTERVAL" in opengl_drawable_flush() wipes it as well.
+     * The CGL surface then stays pinned to the initial backing size (1x1) and
+     * gets stretched across the whole window.  Re-sync whenever the live client
+     * rect has actually changed so the next present uses the real size. */
+    if (context->draw_view && context->draw_hwnd == base->client->hwnd)
+    {
+        RECT rect;
+
+        NtUserGetClientRect(context->draw_hwnd, &rect, NtUserGetDpiForWindow(context->draw_hwnd));
+        if (!EqualRect(&rect, &context->draw_rect))
+        {
+            context->draw_rect = rect;
+            flags |= GL_FLUSH_UPDATED;
+        }
+    }
+
     if (flags & GL_FLUSH_UPDATED) make_context_current(context, context->read_view == client->cocoa_view);
 }
 
