+        //
+        // El reintento va aquí y no en la ruta de ordenado: conceder el foco desde dentro del
+        // ordenado re-entra en AppKit y cuelga a algunos juegos antes siquiera de crear su
+        // ventana —reproducido con Runika, que se paraba tras inicializar su input—.
+        dispatch_after(dispatch_time( DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC) ),
+                       dispatch_get_main_queue(), ^{
+            WineWindow* windowToFocus;
+
+            if (![NSApp isActive]) return;
+            if ([[NSApp keyWindow] isKindOfClass:[WineWindow class]]) return;
+            windowToFocus = [self frontWineWindow];
+            if ([windowToFocus canBecomeKeyWindow])
+                [windowToFocus makeKeyWindow];
+        });
+
