+/* Regression: select an alternate graphics backend for this process without
+ * replacing the DXMT modules installed in the default Wine tree.  CrossOver
+ * implements the same directory-prepending model in cxcompatdb; Regression
+ * keeps the policy open and independent. */
+static int regression_executable_is( const char *name )
+{
+    const WCHAR *exe = main_wargv[0];
+    const WCHAR *cursor;
+
+    for (cursor = exe; *cursor; cursor++)
+        if (*cursor == '\\' || *cursor == '/') exe = cursor + 1;
+
+    while (*exe && *name)
+    {
+        if (towlower( *exe++ ) != (unsigned char)*name++) return 0;
+    }
+    return !*exe && !*name;
+}
+
+extern void add_load_order_override( const WCHAR *entry );
+
+static void regression_force_builtin_load_order( const char *module )
+{
+    WCHAR entry[64];
+    size_t i, length = strlen( module );
+
+    if (length + 3 > ARRAY_SIZE( entry )) return;
+    for (i = 0; i < length; i++) entry[i] = (unsigned char)module[i];
+    entry[i++] = '=';
+    entry[i++] = 'b';
+    entry[i] = 0;
+    add_load_order_override( entry );
 }
