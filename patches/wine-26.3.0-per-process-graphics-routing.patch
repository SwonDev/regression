+
+/* Regression: select an alternate graphics backend for this process without
+ * replacing the DXMT modules installed in the default Wine tree.  CrossOver
+ * implements the same directory-prepending model in cxcompatdb; Regression
+ * keeps the policy open and independent. */
+static int regression_executable_is( const char *name )
+{
+    const WCHAR *exe = main_wargv[0];
+    const WCHAR *cursor;
+
+    for (cursor = exe; *cursor; cursor++)
+        if (*cursor == '\\' || *cursor == '/') exe = cursor + 1;
+
+    while (*exe && *name)
+    {
+        unsigned char expected = (unsigned char)*name++;
+        if (expected >= 'A' && expected <= 'Z') expected += 'a' - 'A';
+        if (towlower( *exe++ ) != expected) return 0;
+    }
+    return !*exe && !*name;
+}
+
+static int regression_executable_matches_env( const char *variable )
+{
+    const char *name = getenv( variable );
+
+    if (!name || !name[0] || strlen( name ) >= 128 ||
+        strchr( name, '/' ) || strchr( name, '\\' ) || strchr( name, ':' ))
+        return 0;
+    return regression_executable_is( name );
 }
 
+static unsigned int regression_route_count( const char *variable )
+{
+    const char *value = getenv( variable );
+    char *end;
+    unsigned long count;
+
+    if (!value || !value[0]) return 0;
+    count = strtoul( value, &end, 10 );
+    if (*end || !count || count > 16) return 0;
+    return count;
+}
+
+static int regression_path_basename_is( const char *path, const char *name )
+{
+    const char *cursor, *basename = path;
+
+    if (!path || !name) return 0;
+    for (cursor = path; *cursor; cursor++)
+        if (*cursor == '/' || *cursor == '\\') basename = cursor + 1;
+    return !strcasecmp( basename, name );
+}
+
+struct regression_builtin_bootstrap_route
+{
+    const char *executable;
+    const char *target_suffix;
+};
+
+/* Steam starts games through wineserver and does not reliably preserve Unix-only
+ * variables for the new loader process. These entries are therefore compiled,
+ * exact-name recipes; they never come from the learning database or registry. */
+static const struct regression_builtin_bootstrap_route regression_builtin_bootstrap_routes[] =
+{
+    {
+        "TQ2.exe",
+        "/drive_c/Program Files (x86)/Steam/steamapps/common/Titan Quest II/"
+        "TQ2/Binaries/Win64/TQ2-Win64-Shipping.exe"
+    },
+};
+
+static int regression_executable_requires_gptk_4_0b2(void)
+{
+    return regression_executable_is( "tq2-win64-shipping.exe" ) ||
+           regression_executable_is( "borderlands4.exe" );
+}
+
+static const char *regression_internal_gptk_3_0_profile_suffix(void)
+{
+    if (regression_executable_is( "grim dawn.exe" ))
+        return "/lib/profiles/grim-dawn";
+    if (regression_executable_is( "dd2.exe" ))
+        return "/lib/profiles/dragons-dogma-2";
+    if (regression_executable_is( "dsclient-win64-shipping.exe" ))
+        return "/lib/profiles/dragonsword";
+    return NULL;
+}
+
+static int regression_internal_gptk_3_0_is_verified(void)
+{
+    const char *verified = getenv( "REGRESSION_INTERNAL_GPTK_3_0_VERIFIED" );
+
+    return verified && !strcmp( verified, "1" );
+}
+
+static int regression_internal_profile_is_accessible( const char *root, const char *suffix )
+{
+    char *candidate;
+    char resolved[PATH_MAX];
+    struct stat st;
+    int accessible = 0;
+
+    if (root && root[0])
+    {
+        if (asprintf( &candidate, "%s%s", root, suffix ) < 0) return 0;
+    }
+    else
+    {
+        if (asprintf( &candidate, "%s/../..%s", ntdll_dir, suffix + 4 ) < 0) return 0;
+    }
+    if (realpath( candidate, resolved ) && !stat( resolved, &st ) && S_ISDIR( st.st_mode ) &&
+        !access( resolved, R_OK | X_OK )) accessible = 1;
+    free( candidate );
+    return accessible;
+}
+
+static const char *regression_external_d3dmetal_root(void)
+{
+    const char *legacy_root;
+    unsigned int i, count;
+    char executable_variable[80], root_variable[80];
+
+    if (regression_executable_matches_env( "REGRESSION_EXTERNAL_D3DMETAL_EXECUTABLE" ))
+    {
+        legacy_root = getenv( "REGRESSION_EXTERNAL_D3DMETAL_WINE_ROOT" );
+        if (legacy_root && legacy_root[0]) return legacy_root;
+    }
+
+    count = regression_route_count( "REGRESSION_EXTERNAL_D3DMETAL_ROUTE_COUNT" );
+    for (i = 0; i < count; i++)
+    {
+        snprintf( executable_variable, sizeof(executable_variable),
+                  "REGRESSION_EXTERNAL_D3DMETAL_ROUTE_%u_EXECUTABLE", i );
+        if (!regression_executable_matches_env( executable_variable )) continue;
+        snprintf( root_variable, sizeof(root_variable),
+                  "REGRESSION_EXTERNAL_D3DMETAL_ROUTE_%u_WINE_ROOT", i );
+        legacy_root = getenv( root_variable );
+        if (legacy_root && legacy_root[0]) return legacy_root;
+    }
+    return NULL;
+}
+
+static void regression_redirect_bootstrap( int argc, char *argv[] )
+{
+    const char *prefix = getenv( "WINEPREFIX" );
+    const char *source, *target;
+    char **executable_arg;
+    char source_variable[80], target_variable[80];
+    char candidate_target[PATH_MAX], resolved_prefix[PATH_MAX], resolved_target[PATH_MAX];
+    size_t prefix_length;
+    unsigned int i, count;
+
+    if (argc <= 0 || !prefix || !prefix[0] ||
+        getenv( "REGRESSION_BOOTSTRAP_REDIRECTED" )) return;
+    executable_arg = argc > 1 ? &argv[1] : &argv[0];
+    if (!realpath( prefix, resolved_prefix )) return;
+    prefix_length = strlen( resolved_prefix );
+    count = regression_route_count( "REGRESSION_BOOTSTRAP_REDIRECT_COUNT" );
+
+    for (i = 0; i < count; i++)
+    {
+        snprintf( source_variable, sizeof(source_variable),
+                  "REGRESSION_BOOTSTRAP_REDIRECT_%u_EXECUTABLE", i );
+        snprintf( target_variable, sizeof(target_variable),
+                  "REGRESSION_BOOTSTRAP_REDIRECT_%u_TARGET", i );
+        source = getenv( source_variable );
+        target = getenv( target_variable );
+        if (!source || !source[0] || strlen( source ) >= 128 ||
+            strchr( source, '/' ) || strchr( source, '\\') || strchr( source, ':' ) ||
+            !target || !target[0] ||
+            !regression_path_basename_is( *executable_arg, source ) ||
+            !realpath( target, resolved_target )) continue;
+
+        if (strlen( resolved_target ) < prefix_length + 9 ||
+            strncmp( resolved_target, resolved_prefix, prefix_length ) ||
+            strncmp( resolved_target + prefix_length, "/drive_c/", 9 )) continue;
+        *executable_arg = strdup( resolved_target );
+        if (!*executable_arg) return;
+        setenv( "REGRESSION_BOOTSTRAP_REDIRECTED", "1", 1 );
+        fprintf( stderr, "Regression: redirected exact bootstrap %s to %s.\n",
+                 source, resolved_target );
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE( regression_builtin_bootstrap_routes ); i++)
+    {
+        const struct regression_builtin_bootstrap_route *route =
+            &regression_builtin_bootstrap_routes[i];
+        int target_length;
+
+        target_length = snprintf( candidate_target, sizeof(candidate_target), "%s%s",
+                                  resolved_prefix, route->target_suffix );
+        if (!regression_path_basename_is( *executable_arg, route->executable ) || target_length < 0 ||
+            (size_t)target_length >= sizeof(candidate_target) ||
+            access( candidate_target, R_OK )) continue;
+
+        /* The Steam library is deliberately shared with the canonical
+         * CrossOver bottle through a steamapps symlink.  realpath() would
+         * therefore escape the Regression prefix even though this logical
+         * path is a fixed, compiled suffix below drive_c.  Keep environment
+         * routes on the strict realpath boundary above; compiled routes are
+         * safe to execute through their generated in-prefix path. */
+        *executable_arg = strdup( candidate_target );
+        if (!*executable_arg) return;
+        setenv( "REGRESSION_BOOTSTRAP_REDIRECTED", "1", 1 );
+        fprintf( stderr, "Regression: redirected compiled bootstrap %s to %s.\n",
+                 route->executable, candidate_target );
+        return;
+    }
+}
+
+extern void add_load_order_override( const WCHAR *entry );
+
+static void regression_force_builtin_load_order( const char *module )
+{
+    WCHAR entry[64];
+    size_t i, length = strlen( module );
+
+    if (length + 3 > ARRAY_SIZE( entry )) return;
+    for (i = 0; i < length; i++) entry[i] = (unsigned char)module[i];
+    entry[i++] = '=';
+    entry[i++] = 'b';
+    entry[i] = 0;
+    add_load_order_override( entry );
+}
+
+static void regression_set_graphics_backend(void)
+{
+    const char *backend = getenv( "REGRESSION_GRAPHICS_BACKEND" );
+    const char *root = getenv( "REGRESSION_WINE_ROOT" );
+    const char *external_d3dmetal_wine_root = regression_external_d3dmetal_root();
+    int is_cubeworld = regression_executable_is( "cubeworld.exe" );
+    int is_grim_dawn = regression_executable_is( "grim dawn.exe" );
+    int is_dragons_dogma_2 = regression_executable_is( "dd2.exe" );
+    int is_dragonsword = regression_executable_is( "dsclient-win64-shipping.exe" );
+    int is_heroes_hammerwatch_2 = regression_executable_is( "hwr2.exe" );
+    int is_external_d3dmetal = external_d3dmetal_wine_root != NULL;
+    const char *internal_gptk_3_0_suffix = regression_internal_gptk_3_0_profile_suffix();
+    const char *suffix;
+    char *path;
+
+    /* These three certified profiles contain one indivisible GPTK 3.0 route.
+     * Directory presence is not authority: the launcher must first verify the
+     * exact generation's receipt and hashes. Neither an inherited marker nor
+     * a preserved 2.1 payload may select this route. */
+    if (internal_gptk_3_0_suffix && !regression_internal_gptk_3_0_is_verified())
+    {
+        ERR( "required internal GPTK 3.0 component is unavailable or unauthorized for this process\n" );
+        exit( 126 );
+    }
+
+    /* A missing or malformed verified profile must not fall through to the
+     * global DXMT/DXVK tree, even when Steam created the loader process. */
+    if (internal_gptk_3_0_suffix &&
+        !regression_internal_profile_is_accessible( root, internal_gptk_3_0_suffix ))
+    {
+        ERR( "required internal GPTK 3.0 profile is unavailable or invalid: %s\n",
+             internal_gptk_3_0_suffix );
+        exit( 126 );
+    }
+
+    /* The application and launcher validate the Apple license receipt and
+     * exact component before exporting a route. A compiled GPTK process must
+     * never fall back to the global DXMT/DXVK tree merely because its launch
+     * originated from Steam instead of Regression's game button. */
+    if (regression_executable_requires_gptk_4_0b2() && !is_external_d3dmetal)
+    {
+        ERR( "external D3DMetal component is unavailable or unauthorized for this process\n" );
+        exit( 126 );
+    }
+
+    if (!backend || !backend[0])
+    {
+        if (is_cubeworld) backend = "dxvk";
+        else if (is_grim_dawn) backend = "grim-dawn";
+        else if (is_dragons_dogma_2) backend = "dragons-dogma-2";
+        else if (is_dragonsword) backend = "dragonsword";
+        else if (is_heroes_hammerwatch_2) backend = "heroes-hammerwatch-2";
+        else if (is_external_d3dmetal) backend = "external-d3dmetal";
+        else if (regression_executable_is( "fft_enhanced.exe" )) backend = "d3dmetal";
+        else return;
+    }
+
+    if (!strcasecmp( backend, "external-d3dmetal" ) && is_external_d3dmetal)
+    {
+        char *component_path;
+
+        if (!external_d3dmetal_wine_root || !external_d3dmetal_wine_root[0])
+        {
+            WARN( "external D3DMetal profile requires a verified Wine root\n" );
+            return;
+        }
+        path = strdup( external_d3dmetal_wine_root );
+        if (!path) return;
+        if (asprintf( &component_path, "%s/../external/libd3dshared.dylib", path ) >= 0)
+        {
+            if (!access( component_path, R_OK ))
+                setenv( "CX_APPLEGPTK_LIBD3DSHARED_PATH", component_path, 1 );
+            free( component_path );
+        }
+        if (asprintf( &component_path,
+                      "%s/../external/D3DMetal.framework/Versions/A/D3DMetal", path ) >= 0)
+        {
+            if (!access( component_path, R_OK | X_OK ))
+                setenv( "D3DMETAL_FRAMEWORK_PATH", component_path, 1 );
+            free( component_path );
+        }
+    }
+    else if (!strcasecmp( backend, "dxvk" )) suffix = "/lib/dxvk";
+    else if (!strcasecmp( backend, "grim-dawn" )) suffix = "/lib/profiles/grim-dawn";
+    else if (!strcasecmp( backend, "dragons-dogma-2" )) suffix = "/lib/profiles/dragons-dogma-2";
+    else if (!strcasecmp( backend, "dragonsword" )) suffix = "/lib/profiles/dragonsword";
+    else if (!strcasecmp( backend, "heroes-hammerwatch-2" )) suffix = "/lib/profiles/heroes-hammerwatch-2";
+    else if (!strcasecmp( backend, "d3dmetal" )) suffix = "/lib/apple_gptk/wine";
+    else
+    {
+        WARN( "unknown Regression graphics backend %s\n", backend );
+        return;
+    }
+
+    if (strcasecmp( backend, "external-d3dmetal" ))
+    {
+        if (root && root[0])
+        {
+            if (asprintf( &path, "%s%s", root, suffix ) < 0) return;
+        }
+        else
+        {
+            if (asprintf( &path, "%s/../..%s", ntdll_dir, suffix + 4 ) < 0) return;
+        }
+    }
+    if (access( path, R_OK | X_OK ))
+    {
+        WARN( "Regression graphics backend directory %s is not accessible\n", path );
+        free( path );
+        return;
+    }
+
+    prepend_dll_path( path );
+    if (is_heroes_hammerwatch_2 && !strcasecmp( backend, "heroes-hammerwatch-2" ))
+        /* macOS exposes OpenGL 3.2+ core contexts only as forward-compatible. */
+        setenv( "CX_FWD_COMPAT_GL_CTX", "1", 1 );
+    if (is_cubeworld && !strcasecmp( backend, "dxvk" ))
+        /* CrossOver 26.3 emits discrete resource indexes for this DXVK path. */
+        setenv( "MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS", "0", 1 );
+    if ((is_grim_dawn || is_dragons_dogma_2 || is_dragonsword || is_external_d3dmetal) &&
+        (!strcasecmp( backend, "grim-dawn" ) ||
+         !strcasecmp( backend, "dragons-dogma-2" ) ||
+         !strcasecmp( backend, "dragonsword" ) ||
+         !strcasecmp( backend, "external-d3dmetal" ) ||
+         !strcasecmp( backend, "d3dmetal" )))
+    {
+        /* Match CrossOver's explicit D3DMetal mode for these processes only. */
+        setenv( "CX_GRAPHICS_BACKEND", "d3dmetal", 1 );
+        setenv( "CX_ACTIVE_GRAPHICS_BACKEND", "d3dmetal", 1 );
+        if (is_dragons_dogma_2)
+        {
+            setenv( "WINED3DMETAL", "1", 1 );
+            setenv( "REGRESSION_RETINA_MODE", "y", 1 );
+        }
+        if (is_dragonsword)
+        {
+            /* The Regression bottle globally owns DXMT/DXVK modules.  A
+             * D3DMetal process must select the complete Apple route and the
+             * builtin Wine fallbacks as one coherent set, matching a clean
+             * CrossOver D3DMetal bottle without changing any global key. */
+            setenv( "WINED3DMETAL", "1", 1 );
+            setenv( "REGRESSION_RETINA_MODE", "y", 1 );
+            regression_force_builtin_load_order( "atidxx64" );
+            regression_force_builtin_load_order( "d3d9" );
+            regression_force_builtin_load_order( "dcomp" );
+            regression_force_builtin_load_order( "d3d11" );
+            regression_force_builtin_load_order( "d3d12" );
+            regression_force_builtin_load_order( "dxgi" );
+            regression_force_builtin_load_order( "nvapi64" );
+            regression_force_builtin_load_order( "nvngx" );
+        }
+        if (is_external_d3dmetal)
+        {
+            /* External GPTK modules are builtin Wine modules.  The launcher
+             * supplies an exact executable and a manifest-verified component;
+             * keep that complete D3DMetal route indivisible for this process. */
+            setenv( "WINED3DMETAL", "1", 1 );
+            regression_force_builtin_load_order( "d3d10" );
+            regression_force_builtin_load_order( "d3d11" );
+            regression_force_builtin_load_order( "d3d12" );
+            regression_force_builtin_load_order( "dxgi" );
+            regression_force_builtin_load_order( "nvapi64" );
+            regression_force_builtin_load_order( "nvngx" );
+        }
+        if (is_grim_dawn)
+        {
+            /* The bottle's global d3d9/AMD/NVIDIA overrides belong to other
+             * profiles and otherwise create a mixed route that flickers. */
+            regression_force_builtin_load_order( "atidxx64" );
+            regression_force_builtin_load_order( "d3d9" );
+            regression_force_builtin_load_order( "nvapi64" );
+            regression_force_builtin_load_order( "nvngx" );
+        }
+    }
+    TRACE( "Regression selected graphics backend %s from %s\n", backend, path );
+}
+
 static void set_dll_path(void)
 {
     char *p, *path = getenv( "WINEDLLPATH" );
@@ -2246,18 +2589,19 @@ static void start_main_thread(void)
     {
         void *cxcompatdb = NULL;
         char *name = NULL;
 
         asprintf( &name, "%s/cxcompatdb.so", ntdll_dir );
