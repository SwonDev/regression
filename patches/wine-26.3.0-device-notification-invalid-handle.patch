@@ -72,8 +73,11 @@ static CONFIGRET map_error( DWORD error, CONFIGRET default_error )
     return default_error;
 }
 
+#define CM_NOTIFY_CONTEXT_MAGIC 0xbeef4dad
+
 struct cm_notify_context
 {
+    DWORD magic;
     HDEVNOTIFY notify;
     void *user_data;
     PCM_NOTIFY_CALLBACK callback;
@@ -207,6 +211,7 @@ CONFIGRET WINAPI CM_Register_Notification( PCM_NOTIFY_FILTER filter, void *user_
 
     if (!(ctx = calloc( 1, sizeof(*ctx) ))) return CR_OUT_OF_MEMORY;
 
+    ctx->magic = CM_NOTIFY_CONTEXT_MAGIC;
