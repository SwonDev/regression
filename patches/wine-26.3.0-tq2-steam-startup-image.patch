 /*************************************************************************
+ *              regression_tq2_shipping_image
+ *
+ * Steam-created Wine processes receive their image path from wineserver,
+ * independently of the Unix argv seen by the child loader.  Redirect only the
+ * exact Titan Quest II bootstrap to its real Unreal executable.  The fixed
+ * suffix keeps this recipe isolated from every other executable and title.
+ */
+static WCHAR *regression_tq2_shipping_image( const WCHAR *image, UINT image_len,
+                                             UINT *redirected_len )
+{
+    static const char required_suffix[] =
+        "\\steamapps\\common\\Titan Quest II\\TQ2.exe";
+    static const char bootstrap_tail[] = "\\TQ2.exe";
+    static const char shipping_tail[] =
+        "\\TQ2\\Binaries\\Win64\\TQ2-Win64-Shipping.exe";
+    size_t image_chars = image_len / sizeof(WCHAR);
+    size_t required_chars = sizeof(required_suffix) - 1;
+    size_t bootstrap_chars = sizeof(bootstrap_tail) - 1;
+    size_t shipping_chars = sizeof(shipping_tail) - 1;
+    size_t prefix_chars, target_chars, i;
+    WCHAR *target;
+
+    if (image_len % sizeof(WCHAR) || image_chars < required_chars) return NULL;
+    for (i = 0; i < required_chars; i++)
+    {
+        WCHAR actual = ntdll_towupper( image[image_chars - required_chars + i] );
+        WCHAR expected = ntdll_towupper( (unsigned char)required_suffix[i] );
+        if (actual != expected) return NULL;
+    }
+
+    prefix_chars = image_chars - bootstrap_chars;
+    target_chars = prefix_chars + shipping_chars;
+    if (target_chars > (USHRT_MAX / sizeof(WCHAR)) - 1) return NULL;
+    if (!(target = malloc( (target_chars + 1) * sizeof(WCHAR) ))) return NULL;
+
+    memcpy( target, image, prefix_chars * sizeof(WCHAR) );
+    for (i = 0; i < shipping_chars; i++)
+        target[prefix_chars + i] = (unsigned char)shipping_tail[i];
+    target[target_chars] = 0;
+    *redirected_len = target_chars * sizeof(WCHAR);
+    return target;
+}
