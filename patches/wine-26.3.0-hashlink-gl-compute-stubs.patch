+static int regression_directory_has_file( const char *directory, const char *name )
+{
+    char path[PATH_MAX];
+    struct stat st;
+    int length;
+
+    length = snprintf( path, sizeof(path), "%s/%s", directory, name );
+    if (length < 0 || (size_t)length >= sizeof(path)) return 0;
+    if (lstat( path, &st )) return 0;
+    return S_ISREG( st.st_mode );
 }
 
+/* HashLink ships one runtime for every Heaps/HashLink title.  Its Windows
+ * build resolves the whole GL import table through wglGetProcAddress and stops
+ * at the first entry that fails to resolve, so the compute and SSBO entry
+ * points macOS cannot expose above GL 4.1 abort the game before it draws.  The
+ * evidence is the runtime itself, never a per-title list: only a game root that
+ * carries the HashLink bytecode and its runtime library selects the compiled
+ * compatibility set, so every present and future HashLink title is covered and
+ * no other engine is touched. */
+static void regression_set_hashlink_gl_compatibility(void)
+{
+    char *unix_executable = NULL, *game_root = NULL;
+    NTSTATUS status;
+
+    status = ntdll_get_unix_file_name( main_wargv[0], &unix_executable, FILE_OPEN );
+    if (status && status != STATUS_NO_SUCH_FILE) goto done;
+    if (!unix_executable || !(game_root = regression_steam_game_root( unix_executable ))) goto done;
+    if (!regression_directory_has_file( game_root, "hlboot.dat" )) goto done;
+    if (!regression_directory_has_file( game_root, "libhl.dll" )) goto done;
+
+    setenv( "REGRESSION_GL_HASHLINK_RUNTIME", "1", 1 );
+    fprintf( stderr, "Regression: HashLink runtime detected for %s; unavailable GL compute "
+             "entry points resolve to reporting stubs.\n", unix_executable );
+
+done:
+    free( game_root );
+    free( unix_executable );
+}
