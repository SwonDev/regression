+/* Regression: HashLink resolves its entire GL import table through
+ * wglGetProcAddress before the first frame and stops at the first entry that
+ * fails to resolve.  macOS froze OpenGL at 4.1, so the compute, SSBO and
+ * indirect entry points it asks for can never resolve and every Heaps title
+ * dies with a driver error even though it never issues a compute dispatch.
+ * These stubs let that resolution succeed without pretending to do the work:
+ * each one reports the first time it is actually invoked, so a title that does
+ * depend on compute leaves evidence in the log instead of rendering silently
+ * wrong.  Only a process the loader recognised as a HashLink runtime reaches
+ * them; every other engine keeps the unmodified failure and its own fallback. */
+static BOOL regression_hashlink_runtime(void)
+{
+    static int cached = -1;
+
+    if (cached < 0)
+    {
+        const char *value = getenv( "REGRESSION_GL_HASHLINK_RUNTIME" );
+        cached = value && value[0] == '1';
+    }
+    return cached != 0;
+}
+
+static void regression_report_missing_gl( const char *name, int *reported )
+{
+    if (*reported) return;
+    *reported = 1;
+    ERR( "%s is unavailable on this driver and the HashLink stub did nothing\n", name );
 }
 
+#define REGRESSION_REPORT_MISSING_GL( name ) \
+    do { static int reported; regression_report_missing_gl( (name), &reported ); } while (0)
+
+static void GLAPIENTRY regression_stub_dispatch_compute( GLuint x, GLuint y, GLuint z )
+{
+    REGRESSION_REPORT_MISSING_GL( "glDispatchCompute" );
+}
+
+static void GLAPIENTRY regression_stub_memory_barrier( GLbitfield barriers )
+{
+    REGRESSION_REPORT_MISSING_GL( "glMemoryBarrier" );
+}
+
+static void GLAPIENTRY regression_stub_bind_image_texture( GLuint unit, GLuint texture, GLint level,
+                                                           GLboolean layered, GLint layer,
+                                                           GLenum access, GLenum format )
+{
+    REGRESSION_REPORT_MISSING_GL( "glBindImageTexture" );
+}
+
+static void GLAPIENTRY regression_stub_shader_storage_block_binding( GLuint program, GLuint index,
+                                                                     GLuint binding )
+{
+    REGRESSION_REPORT_MISSING_GL( "glShaderStorageBlockBinding" );
+}
+
+static GLuint GLAPIENTRY regression_stub_get_program_resource_index( GLuint program,
+                                                                     GLenum programInterface,
+                                                                     const char *name )
+{
+    REGRESSION_REPORT_MISSING_GL( "glGetProgramResourceIndex" );
+    return ~0u;
+}
+
+static void GLAPIENTRY regression_stub_multi_draw_elements_indirect( GLenum mode, GLenum type,
+                                                                     const void *indirect,
+                                                                     GLsizei drawcount, GLsizei stride )
+{
+    REGRESSION_REPORT_MISSING_GL( "glMultiDrawElementsIndirect" );
+}
+
+static void GLAPIENTRY regression_stub_multi_draw_elements_indirect_count( GLenum mode, GLenum type,
+                                                                           const void *indirect,
+                                                                           GLintptr drawcount,
+                                                                           GLsizei maxdrawcount,
+                                                                           GLsizei stride )
+{
+    REGRESSION_REPORT_MISSING_GL( "glMultiDrawElementsIndirectCountARB" );
+}
+
+static const void *regression_hashlink_gl_stub( const char *name )
+{
+    static const struct { const char *name; const void *stub; } stubs[] =
+    {
+        { "glBindImageTexture", (const void *)regression_stub_bind_image_texture },
+        { "glDispatchCompute", (const void *)regression_stub_dispatch_compute },
+        { "glGetProgramResourceIndex", (const void *)regression_stub_get_program_resource_index },
+        { "glMemoryBarrier", (const void *)regression_stub_memory_barrier },
+        { "glMultiDrawElementsIndirect", (const void *)regression_stub_multi_draw_elements_indirect },
+        { "glMultiDrawElementsIndirectCountARB",
+          (const void *)regression_stub_multi_draw_elements_indirect_count },
+        { "glShaderStorageBlockBinding", (const void *)regression_stub_shader_storage_block_binding },
+    };
+    unsigned int i;
+
+    if (!regression_hashlink_runtime()) return NULL;
+    for (i = 0; i < ARRAY_SIZE(stubs); i++)
+        if (!strcmp( name, stubs[i].name )) return stubs[i].stub;
+    return NULL;
+}
