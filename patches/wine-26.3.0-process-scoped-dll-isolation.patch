+/* Consume only the closed, local activation format written by Regression.
+ * A record can select one compiled recipe for one exact executable basename;
+ * it cannot name a DLL, path, load order, URL or command. */
+/* Resolve whether this process really belongs to the Steam application named by an
+ * activation record. The record carries an App ID; the process proves it by living
+ * inside the install directory Steam recorded for that App ID, which is read from the
+ * app manifest next to the library. Nothing here comes from the environment, so a second
+ * game started from the same Steam session cannot inherit the identity of the first one.
+ * Any doubt returns 0 and the learned repair is simply not applied. */
+static int regression_process_belongs_to_steam_app( const char *app_id )
+{
+    static const char library_marker[] = "\\steamapps\\common\\";
+    static const char manifest_key[] = "\"installdir\"";
+    const char *prefix = getenv( "WINEPREFIX" );
+    const WCHAR *image = main_wargv[0];
+    char image_path[PATH_MAX], install_dir[128], manifest[PATH_MAX], line[512];
+    char *marker, *cursor, *value, *end;
+    size_t i, length, library_length, install_length = 0;
+    struct stat st;
+    FILE *file;
+    int fd, matched = 0, written;
+
+    if (!app_id || !app_id[0] || !prefix || !prefix[0] || !image) return 0;
+    for (i = 0; app_id[i]; i++)
+        if (app_id[i] < '0' || app_id[i] > '9' || i >= 10) return 0;
+
+    /* The image path must be plain ASCII below drive C: to be comparable at all. */
+    for (length = 0; image[length]; length++)
+    {
+        if (length + 1 >= sizeof(image_path) || image[length] > 0x7f) return 0;
+        image_path[length] = (char)image[length];
+    }
+    image_path[length] = 0;
+    if (length < 3 || (image_path[0] != 'C' && image_path[0] != 'c') ||
+        image_path[1] != ':' || image_path[2] != '\\') return 0;
+
+    if (!(marker = strcasestr( image_path, library_marker ))) return 0;
+    library_length = (size_t)(marker - image_path) + strlen( "\\steamapps" );
+
+    cursor = marker + strlen( library_marker );
+    while (*cursor && *cursor != '\\')
+    {
+        if (install_length + 1 >= sizeof(install_dir)) return 0;
+        install_dir[install_length++] = *cursor++;
+    }
+    if (!install_length || *cursor != '\\') return 0;
+    install_dir[install_length] = 0;
+
+    /* Rebuild the Unix path of the library that contains this image, then the manifest
+     * Steam keeps for the declared App ID. A library outside drive_c never matches. */
+    written = snprintf( manifest, sizeof(manifest), "%s/drive_c/", prefix );
+    if (written < 0 || (size_t)written >= sizeof(manifest)) return 0;
+    for (i = 3; i < library_length; i++)
+    {
+        if ((size_t)written + 1 >= sizeof(manifest)) return 0;
+        manifest[written++] = image_path[i] == '\\' ? '/' : image_path[i];
+    }
+    manifest[written] = 0;
+    if ((size_t)snprintf( manifest + written, sizeof(manifest) - written,
+                          "/appmanifest_%s.acf", app_id ) >= sizeof(manifest) - written)
+        return 0;
+
+    if (lstat( manifest, &st ) || !S_ISREG( st.st_mode ) || st.st_uid != geteuid() ||
+        st.st_size <= 0 || st.st_size > 4 * 1024 * 1024) return 0;
+    if ((fd = open( manifest, O_RDONLY | O_CLOEXEC | O_NOFOLLOW )) == -1) return 0;
+    if (!(file = fdopen( fd, "r" )))
+    {
+        close( fd );
+        return 0;
+    }
+    while (fgets( line, sizeof(line), file ))
+    {
+        if (!(cursor = strstr( line, manifest_key ))) continue;
+        if (!(value = strchr( cursor + strlen( manifest_key ), '"' ))) break;
+        value++;
+        if (!(end = strchr( value, '"' ))) break;
+        *end = 0;
+        matched = !strcasecmp( value, install_dir );
+        break;
+    }
+    fclose( file );
+    return matched;
+}
