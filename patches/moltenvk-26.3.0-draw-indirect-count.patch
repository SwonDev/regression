+#pragma mark -
+#pragma mark MVKCmdDrawIndirectCount
+
+// El contador vive en la GPU y puede escribirse en el mismo command buffer, así que no se puede
+// leer desde la CPU al grabar. Se recorta en la GPU justo antes de dibujar: un kernel copia los
+// argumentos de los draws por debajo del contador y anula el resto poniendo su cuenta de vértices
+// (o de índices) a cero, que en Metal es un draw que no dibuja nada. Después se encodean
+// `maxDrawCount` draws indirectos sobre ese buffer ya recortado.
+template<typename CmdType>
+static void mvkEncodeIndirectCountDraw(MVKCommandEncoder* cmdEncoder,
+									   bool indexed,
+									   id<MTLBuffer> indirectBuff,
+									   VkDeviceSize indirectBuffOffset,
+									   uint32_t indirectBuffStride,
+									   id<MTLBuffer> countBuff,
+									   VkDeviceSize countBuffOffset,
+									   uint32_t maxDrawCount,
+									   uint32_t destStride,
+									   CmdType&& encodeDraw) {
+	if ( !maxDrawCount ) { return; }
+
+	cmdEncoder->restartMetalRenderPassIfNeeded();
+
+	auto* clampedBuff = cmdEncoder->getTempMTLBuffer(destStride * maxDrawCount, true);
+
+	cmdEncoder->encodeStoreActions(true);
+	id<MTLComputeCommandEncoder> mtlClampEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDrawIndirectConvertBuffers);
+	id<MTLComputePipelineState> mtlClampState = cmdEncoder->getCommandEncodingPool()->getCmdDrawIndirectClampCountMTLComputePipelineState(indexed);
+	[mtlClampEncoder setComputePipelineState: mtlClampState];
+	[mtlClampEncoder setBuffer: indirectBuff offset: indirectBuffOffset atIndex: 0];
+	[mtlClampEncoder setBuffer: clampedBuff->_mtlBuffer offset: clampedBuff->_offset atIndex: 1];
+	cmdEncoder->setComputeBytes(mtlClampEncoder, &indirectBuffStride, sizeof(indirectBuffStride), 2);
+	cmdEncoder->setComputeBytes(mtlClampEncoder, &maxDrawCount, sizeof(maxDrawCount), 3);
+	[mtlClampEncoder setBuffer: countBuff offset: countBuffOffset atIndex: 4];
+	if (cmdEncoder->getMetalFeatures().nonUniformThreadgroups) {
+#if MVK_MACOS_OR_IOS
+		[mtlClampEncoder dispatchThreads: MTLSizeMake(maxDrawCount, 1, 1)
+				   threadsPerThreadgroup: MTLSizeMake(mtlClampState.threadExecutionWidth, 1, 1)];
+#endif
+	} else {
+		[mtlClampEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(maxDrawCount, mtlClampState.threadExecutionWidth), 1, 1)
+						threadsPerThreadgroup: MTLSizeMake(mtlClampState.threadExecutionWidth, 1, 1)];
+	}
+
+	// Se vuelve a renderizar con el buffer ya recortado.
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+	encodeDraw(clampedBuff);
 }
 
+VkResult MVKCmdDrawIndirectCount::setContent(MVKCommandBuffer* cmdBuff,
+											 VkBuffer buffer,
+											 VkDeviceSize offset,
+											 VkBuffer countBuffer,
+											 VkDeviceSize countBufferOffset,
+											 uint32_t maxDrawCount,
+											 uint32_t stride) {
+	auto* mvkBuff = (MVKBuffer*)buffer;
+	auto* mvkCountBuff = (MVKBuffer*)countBuffer;
+	_mtlIndirectBuffer = mvkBuff->getMTLBuffer();
+	_mtlIndirectBufferOffset = mvkBuff->getMTLBufferOffset() + offset;
+	_mtlCountBuffer = mvkCountBuff->getMTLBuffer();
+	_mtlCountBufferOffset = mvkCountBuff->getMTLBufferOffset() + countBufferOffset;
+	_mtlIndirectBufferStride = stride;
+	_maxDrawCount = maxDrawCount;
+
+	auto& mtlFeats = cmdBuff->getMetalFeatures();
+	if ( !mtlFeats.indirectDrawing ) {
+		return cmdBuff->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCmdDrawIndirectCount(): The current device does not support indirect drawing.");
+	}
+
+	return VK_SUCCESS;
+}
+
+void MVKCmdDrawIndirectCount::encode(MVKCommandEncoder* cmdEncoder) {
+	const uint32_t destStride = sizeof(MTLDrawPrimitivesIndirectArguments);
+	mvkEncodeIndirectCountDraw(cmdEncoder, false,
+							   _mtlIndirectBuffer, _mtlIndirectBufferOffset, _mtlIndirectBufferStride,
+							   _mtlCountBuffer, _mtlCountBufferOffset,
+							   _maxDrawCount, destStride,
+							   [&](const MVKMTLBufferAllocation* clampedBuff) {
+		MVKCmdDrawIndirect diCmd;
+		diCmd.setContent(cmdEncoder->_cmdBuffer,
+						 clampedBuff->_mtlBuffer,
+						 clampedBuff->_offset,
+						 _maxDrawCount,
+						 destStride);
+		diCmd.encode(cmdEncoder);
+	});
+}
