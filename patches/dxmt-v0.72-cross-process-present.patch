+  /* Uncork cross-process present: reserved==1 requests a GLOBAL IOSurface-backed
+   * texture (Metal's own shared-texture IOSurfaces are not global, so they can't
+   * be found via IOSurfaceLookup across processes; and bootstrap_register2 mach-
+   * port sharing is sandbox-blocked on modern macOS). We create the IOSurface
+   * ourselves with kIOSurfaceIsGlobal and return its global ID (uint32) in
+   * info->mach_port so the window-owning process can IOSurfaceLookup() it. */
+  if (info->reserved == 1 && !info->mach_port) {
+    size_t bpe = 4; /* BGRA8 */
+    size_t width = info->width ? info->width : 1;
+    size_t height = info->height ? info->height : 1;
+    size_t bpr = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, width * bpe);
+    NSDictionary *props = @{
+      (id)kIOSurfaceWidth: @(width),
+      (id)kIOSurfaceHeight: @(height),
+      (id)kIOSurfaceBytesPerElement: @(bpe),
+      (id)kIOSurfaceBytesPerRow: @(bpr),
+      (id)kIOSurfacePixelFormat: @((uint32_t)0x42475241 /* 'BGRA' */),
+      (id)kIOSurfaceIsGlobal: @YES,
+    };
+    IOSurfaceRef surface = IOSurfaceCreate((CFDictionaryRef)props);
+    if (!surface) {
+      params->ret = 0;
+      return STATUS_SUCCESS;
+    }
+    MTLTextureDescriptor *desc = [[MTLTextureDescriptor alloc] init];
+    fill_texture_descriptor(desc, info);
+    desc.storageMode = MTLStorageModeShared;
+    id<MTLTexture> ret = [device newTextureWithDescriptor:desc iosurface:surface plane:0];
+    params->ret = (obj_handle_t)ret;
+    if (ret) {
+      info->gpu_resource_id = [ret gpuResourceID]._impl;
+      info->mach_port = IOSurfaceGetID(surface); /* GLOBAL id, NOT a mach port */
+    }
+    CFRelease(surface); /* the texture retains it */
+    [desc release];
+    return STATUS_SUCCESS;
+  }
+
   if (info->mach_port) {
     MTLSharedTextureHandle *handle = [[MTLSharedTextureHandle alloc] initWithMachPort:info->mach_port];
     id<MTLTexture> ret = [device newSharedTextureWithHandle:handle];
