+  /* Cross-process present (Uncork): when a swapchain is created for a window owned
+   * by another process (e.g. Chromium's GPU process presenting into the browser
+   * process's CEF window), there is no CAMetalLayer we can reach. Instead we present
+   * into a shared IOSurface-backed texture that the window-owning process (winemac.drv)
+   * looks up by mach port and displays. In that mode encodeCommands() blits into
+   * `cx_target_` and returns a null drawable (nothing to presentDrawable). */
+  void setCrossProcessTarget(WMT::Reference<WMT::Texture> target, uint32_t width, uint32_t height) {
+    cx_target_ = std::move(target);
+    cx_width_ = width;
+    cx_height_ = height;
+    cross_process_ = true;
+    layer_props_.drawable_width = width;
+    layer_props_.drawable_height = height;
+  }
+  bool isCrossProcess() const { return cross_process_; }
+
 private:
   void buildRenderPipelineState(bool is_pq, bool with_hdr_metadata);
 
