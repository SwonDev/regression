+
+    if (regression_linux_uname_enabled &&
+        is_inside_syscall( RSP_sig(ucontext) ) && RAX_sig(ucontext) == 63 &&
+        ((const unsigned char *)RIP_sig(ucontext))[-2] == 0x0f &&
