+/*
+ * Some protected Windows applications invoke Linux helper stubs from a Unix
+ * call dispatched by Wine.  Linux syscall 63 is uname(), while macOS reserves
+ * the same number and raises SIGSYS.  Keep the Linux ABI layout local to this
+ * translation; struct utsname has different field sizes on macOS.
+ */
+#define LINUX_UTSNAME_FIELD_LENGTH 65
+struct linux_utsname_compat
+{
+    char sysname[LINUX_UTSNAME_FIELD_LENGTH];
+    char nodename[LINUX_UTSNAME_FIELD_LENGTH];
+    char release[LINUX_UTSNAME_FIELD_LENGTH];
+    char version[LINUX_UTSNAME_FIELD_LENGTH];
+    char machine[LINUX_UTSNAME_FIELD_LENGTH];
+    char domainname[LINUX_UTSNAME_FIELD_LENGTH];
+};
+
+static const struct linux_utsname_compat linux_utsname_identity =
+{
+    "Linux",
+    "regression",
+    "6.16.7-200.fc42.x86_64",
+    "#1 SMP PREEMPT_DYNAMIC Thu Sep 11 17:46:54 UTC 2025",
+    "x86_64",
+    "(none)"
+};
+static BOOL regression_linux_uname_enabled;
+
 /* CW Hack 23427 */
 static BOOL sequoia_or_later = FALSE;
 #endif
