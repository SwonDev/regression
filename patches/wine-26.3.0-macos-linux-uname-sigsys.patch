     }
 }
 
+/* Gate the Linux ABI compatibility bridge to the one exact process that needs
+ * it.  Clear inherited state first so Steam, CEF and unrelated games can never
+ * opt themselves into a signal-handler behaviour through the environment. */
+static void regression_set_process_abi_compatibility(void)
+{
+    unsetenv( "REGRESSION_LINUX_UNAME_SYSCALL" );
+    if (!regression_executable_is( "borderlands4.exe" )) return;
+    setenv( "REGRESSION_LINUX_UNAME_SYSCALL",
+            "borderlands-4-linux-uname@1", 1 );
+}
+
 /* Enable the optional LGPL Windows Media codec component only for Steam games
  * whose own content tree contains ASF/WMA/WMV assets.  The scan is deliberately
  * bounded, read-only and does not follow symlinks.  This keeps the extra
@@ -2902,6 +2914,7 @@ static void start_main_thread(void)
     }
 
     regression_set_process_dll_isolation();
+    regression_set_process_abi_compatibility();
     regression_set_windows_media_compatibility();
     regression_set_graphics_backend();
 
